# Jev → v0 model routing (API keys)

# AI Gateway key — general workloads
AI_GATEWAY_API_KEY=

# Dedicated AI Gateway key for Jev only. Issued from a team whose Provider
# Allowlist includes typesafe-ai. Falls back to AI_GATEWAY_API_KEY when unset.
AI_GATEWAY_JEV_API_KEY=

# Optional overrides
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
# JEV_MODEL=jev-latest

# Vercel Organizations API (demo org)
ROOT_ORGS_ID=org_ailFG29k2qzI4WQ1sDsvlaAZ
VERCEL_ORGS_TOKEN=

# v0 API key used ONLY to mint keys for child teams via the v0 orgs endpoint.
# Never used for chats.
ROOT_V0_KEY=
DEFAULT_TEAM_ID=team_KGbI1HU49jwwz2wt5hYUuo0q

# v0 API key for the default (commercetools) child team — minted once, then
# stored here. In prod, set this as an env var (serverless filesystems cannot
# persist data/tenant-keys.json).
DEFAULT_TEAM_V0_KEY=
